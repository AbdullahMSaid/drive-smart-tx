# Example environment variables for Royalty Luxury Transportation Services
# Copy to your local .env (never commit real values). In Lovable, secrets are
# stored via the secrets manager, not in a committed .env file.

# ---------------------------------------------------------------------------
# Supabase / Lovable Cloud — client-visible (safe to expose in the browser)
# ---------------------------------------------------------------------------

# Base URL of your Supabase project, used by the browser client
VITE_SUPABASE_URL=https://your-project.supabase.co
# Publishable (anon) key for browser requests; RLS policies still apply
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Legacy alias for the publishable key, kept for compatibility
VITE_SUPABASE_ANON_KEY=your_publishable_key
# Project reference id, occasionally needed by client tooling
VITE_SUPABASE_PROJECT_ID=your_project_ref

# ---------------------------------------------------------------------------
# Supabase — server-only (never expose these to the browser)
# ---------------------------------------------------------------------------

# Supabase project URL used inside server functions and server routes
SUPABASE_URL=https://your-project.supabase.co
# Publishable key used by server-side public/anon reads
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Anon key alias for server-side public reads
SUPABASE_ANON_KEY=your_publishable_key
# Service role key: bypasses RLS — privileged server-only operations only
SUPABASE_SERVICE_ROLE_KEY=your_secret_key
# Project reference id for server-side admin tooling
SUPABASE_PROJECT_ID=your_project_ref

# ---------------------------------------------------------------------------
# AI — lead qualification enrichment (not wired up yet)
# ---------------------------------------------------------------------------

# Lovable AI Gateway key; default path for AI calls from server functions
LOVABLE_API_KEY=your_lovable_ai_gateway_key
# OpenAI API key, if calling OpenAI directly instead of the gateway
OPENAI_API_KEY=sk-your_openai_api_key
# OpenRouter API key, if routing AI requests through OpenRouter
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key

# ---------------------------------------------------------------------------
# Email notifications for new rental leads (not wired up yet)
# ---------------------------------------------------------------------------

# Resend API key used to send lead notification and confirmation emails
RESEND_API_KEY=re_your_resend_api_key
# Inbox that receives new lead notifications
OWNER_EMAIL=royaltylux8@gmail.com
# Verified "from" address used when sending transactional email
FROM_EMAIL=no-reply@your-domain.com

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Public site URL, used for absolute links in emails and metadata
VITE_SITE_URL=https://drive-smart-tx.lovable.app
# Shared secret for verifying inbound webhook signatures
WEBHOOK_SECRET=your_random_webhook_secret
